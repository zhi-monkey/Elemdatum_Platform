# Whether to open mock
VITE_USE_MOCK = false

# public path
VITE_PUBLIC_PATH = /

# Delete console
VITE_DROP_CONSOLE = true

# Whether to enable gzip or brotli compression
# Optional: gzip | brotli | none
# If you need multiple forms, you can use `,` to separate
VITE_BUILD_COMPRESS = 'none'

# Whether to delete origin files when using compress, default false
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE = false

# Basic interface address SPA
VITE_GLOB_API_URL=/basic-api

# File upload address， optional
# It can be forwarded by nginx or write the actual address directly
VITE_GLOB_UPLOAD_URL=/upload

# Interface prefix
VITE_GLOB_API_URL_PREFIX=

VITE_GLOB_BACKEND_API_URL = /

# Whether to enable image compression
VITE_USE_IMAGEMIN= true

# use pwa
VITE_USE_PWA = false

# Is it compatible with older browsers
VITE_LEGACY = false

# 默认BASE URL
#VITE_BASE_API = '/'

# TODO: 目前后端连接位于 8960端口 k8s 服务，需要后端调整后再同步调整
# WebSocket 连接地址
#VITE_WS_API = 'ws://{HOST}:8960/ws'

# 数据管理
#VITE_DATA_API = ''

# 训练可视化
#VITE_VISUAL_API = ''

# http://210.30.97.57:30900/minio/upload/dubhe-prod/dataset/8/origin/Snipaste_2023-10-25_21-57-20_tsBcU-rglmYf.jpg
# 用户 minio 访问地址
VITE_MINIO_API = 'http://210.30.96.101:9000/minio/upload'

# atlas 服务，需要单独部署
#VITE_ATLAS_HOST = ''

# 医疗影像 DCM4CHEE 服务访问地址
# 部署文档参考：http://docs.dubhe.ai/docs/setup/deploy-algorithm
#VITE_DCM_API = 'http://{HOST}/dcm4chee/dcm4chee-arc/aets/DCM4CHEE_ADMIN'

# minIO 服务 IP
# 部署文档参考：http://docs.dubhe.ai/docs/setup/deploy-minio
VITE_MINIO_ENDPOINT = '210.30.96.101'

# minIO 服务 端口
VITE_MINIO_PORT = '9000'

# 是否开启 SSL
VITE_MINIO_USESSL = false

# bucketName
VITE_MINIO_BUCKETNAME = 'cz-prod'

# 文档链接
VITE_DOCS_URL = http://docs.tianshu.org.cn/docs/
